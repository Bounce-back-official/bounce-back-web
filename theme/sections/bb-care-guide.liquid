<section class="bb-page-hero color-scheme-1"><div class="bb-shell"><p class="bb-kicker">PRODUCT CARE</p><h1>{{ section.settings.heading }}</h1><p class="bb-copy">{{ section.settings.intro }}</p></div></section>
<section class="bb-content"><div class="bb-shell bb-content__narrow">
  <div class="bb-steps">
    {%- for block in section.blocks -%}<article class="bb-step" {{ block.shopify_attributes }}><span class="bb-step__number">0{{ forloop.index }}</span><div><h2>{{ block.settings.title }}</h2><p>{{ block.settings.text }}</p></div></article>{%- endfor -%}
  </div>
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
</div></section>
{% schema %}
{
  "name":"BB Care guide",
  "settings":[
    {"type":"text","id":"heading","label":"หัวเรื่อง","default":"ดูแลให้พร้อมกลับมาในทุกวัน"},
    {"type":"textarea","id":"intro","label":"คำอธิบาย","default":"รักษารูปทรง สี และประสิทธิภาพของเนื้อผ้าด้วยขั้นตอนง่าย ๆ"}
  ],
  "blocks":[{"type":"step","name":"ขั้นตอนดูแล","settings":[
    {"type":"text","id":"title","label":"หัวข้อ","default":"ซักด้วยน้ำเย็น"},
    {"type":"textarea","id":"text","label":"รายละเอียด","default":"กลับด้านก่อนซัก แยกสี และเลือกโปรแกรมถนอมผ้า"}
  ]}],
  "presets":[{"name":"BB Care guide","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]
}
{% endschema %}
