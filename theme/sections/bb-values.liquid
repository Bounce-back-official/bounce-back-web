<section class="bb-section bb-values color-{{ section.settings.color_scheme }}">
  <div class="bb-shell">
    <div class="bb-values__intro">
      <div><p class="bb-kicker">{{ section.settings.kicker }}</p><h2>{{ section.settings.heading }}</h2></div>
      {%- if section.settings.link_label != blank -%}<a class="bb-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="bb-values__grid">
      {%- for block in section.blocks -%}
        <article class="bb-value" {{ block.shopify_attributes }}>
          <span class="bb-value__index">0{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"BB Values",
  "settings":[
    {"type":"text","id":"kicker","label":"ข้อความเหนือหัวเรื่อง","default":"WHAT WE STAND FOR"},
    {"type":"text","id":"heading","label":"หัวเรื่อง","default":"สร้างมาเพื่อคนที่ล้มได้ และกลับมาได้เสมอ"},
    {"type":"text","id":"link_label","label":"ข้อความลิงก์","default":"เรื่องราวของเรา"},
    {"type":"url","id":"link","label":"ลิงก์"},
    {"type":"color_scheme","id":"color_scheme","label":"ชุดสี","default":"scheme-2"}
  ],
  "blocks":[{"type":"value","name":"คุณค่าของแบรนด์","settings":[
    {"type":"text","id":"title","label":"หัวข้อ","default":"RESILIENT"},
    {"type":"textarea","id":"text","label":"คำอธิบาย","default":"เด้งกลับ เรียนรู้ และแข็งแรงกว่าเดิม"}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"BB Values","blocks":[{"type":"value"},{"type":"value"},{"type":"value"},{"type":"value"}]}]
}
{% endschema %}
