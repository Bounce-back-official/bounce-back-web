<section class="bb-section bb-hero color-{{ section.settings.color_scheme }}">
  <div class="bb-hero__grid">
    <div class="bb-hero__content">
      <p class="bb-kicker">{{ section.settings.kicker }}</p>
      <h1 class="bb-title">{{ section.settings.heading }}</h1>
      <div class="bb-copy bb-hero__lead">{{ section.settings.text }}</div>
      <div class="bb-hero__actions">
        {%- if section.settings.primary_label != blank -%}<a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{%- endif -%}
        {%- if section.settings.secondary_label != blank -%}<a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="bb-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'bb-hero__image', loading: 'eager', widths: '750, 1100, 1500, 1800', sizes: '(min-width: 990px) 48vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
        <span class="bb-hero__image-overlay" aria-hidden="true"></span>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "BB Hero",
  "tag": "section",
  "settings": [
    {"type":"text","id":"kicker","label":"ข้อความเหนือหัวเรื่อง","default":"RETURN ARC / COLLECTION 01"},
    {"type":"textarea","id":"heading","label":"หัวเรื่อง","default":"NO MATTER HOW HARD YOU FALL, YOU CAN ALWAYS BOUNCE BACK."},
    {"type":"richtext","id":"text","label":"คำอธิบาย","default":"<p>เสื้อผ้าออกกำลังกายที่ออกแบบให้คุณกลับมาแข็งแกร่งกว่าเดิม ทุกการเคลื่อนไหว ทุกเป้าหมาย</p>"},
    {"type":"image_picker","id":"image","label":"ภาพนักกีฬา"},
    {"type":"text","id":"primary_label","label":"ปุ่มหลัก","default":"ช้อปสินค้าใหม่"},
    {"type":"url","id":"primary_link","label":"ลิงก์ปุ่มหลัก"},
    {"type":"text","id":"secondary_label","label":"ปุ่มรอง","default":"รู้จัก Bounce Back"},
    {"type":"url","id":"secondary_link","label":"ลิงก์ปุ่มรอง"},
    {"type":"color_scheme","id":"color_scheme","label":"ชุดสี","default":"scheme-1"}
  ],
  "presets":[{"name":"Bounce Back — Hero"}]
}
{% endschema %}
