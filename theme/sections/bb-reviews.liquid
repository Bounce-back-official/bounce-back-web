<section class="bb-section bb-reviews color-{{ section.settings.color_scheme }}">
  <div class="bb-shell">
    <div class="bb-reviews__head"><div><p class="bb-kicker">REAL MOVEMENT. REAL PEOPLE.</p><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="bb-reviews__grid">
      {%- for block in section.blocks -%}
        <article class="bb-review" {{ block.shopify_attributes }}>
          <div class="bb-review__stars" aria-label="5 ดาว">★★★★★</div>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <footer>{{ block.settings.name }}{% if block.settings.detail != blank %} · {{ block.settings.detail }}{% endif %}</footer>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"BB Reviews",
  "settings":[
    {"type":"text","id":"heading","label":"หัวเรื่อง","default":"เสียงจากคนที่ไม่หยุดกลับมา"},
    {"type":"color_scheme","id":"color_scheme","label":"ชุดสี","default":"scheme-2"}
  ],
  "blocks":[{"type":"review","name":"รีวิว","settings":[
    {"type":"textarea","id":"quote","label":"ข้อความรีวิว","default":"ทรงพอดี เคลื่อนไหวง่าย และใส่ได้จริงทั้งวัน"},
    {"type":"text","id":"name","label":"ชื่อ","default":"CUSTOMER NAME"},
    {"type":"text","id":"detail","label":"รายละเอียด","default":"Verified buyer"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"BB Reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]
}
{% endschema %}
