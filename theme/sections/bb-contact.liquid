<section class="bb-page-hero color-scheme-1"><div class="bb-shell"><p class="bb-kicker">CONTACT BOUNCE BACK</p><h1>{{ section.settings.heading }}</h1><p class="bb-copy">{{ section.settings.intro }}</p></div></section>
<section class="bb-content"><div class="bb-shell">
  <div class="bb-contact-grid">
    <article class="bb-contact-card"><p class="bb-kicker">LINE OFFICIAL</p><h2>คุยกับทีมขาย</h2><p>ถามเรื่องสินค้า ไซซ์ สต็อก การจัดส่ง หรือการเปลี่ยนสินค้าได้โดยตรง</p>{%- if settings.bb_line_url != blank -%}<a class="button" href="{{ settings.bb_line_url }}" target="_blank" rel="noopener">{{ settings.bb_line_label }}</a>{%- endif -%}</article>
    <article class="bb-contact-card"><p class="bb-kicker">SUPPORT</p><h2>{{ settings.bb_support_hours }}</h2><p><a href="mailto:{{ settings.bb_support_email }}">{{ settings.bb_support_email }}</a></p><p>เวลาตอบกลับอาจแตกต่างกันในช่วงแคมเปญหรือวันหยุด</p></article>
  </div>
  {%- if page.content != blank -%}<div class="rte bb-content__narrow">{{ page.content }}</div>{%- endif -%}
</div></section>
{% schema %}
{"name":"BB Contact","settings":[{"type":"text","id":"heading","label":"หัวเรื่อง","default":"เราพร้อมช่วยให้คุณกลับไปโฟกัสกับเป้าหมาย"},{"type":"textarea","id":"intro","label":"คำอธิบาย","default":"ติดต่อทีม Bounce Back ผ่าน LINE OA หรืออีเมลในเวลาทำการ"}],"presets":[{"name":"BB Contact"}]}
{% endschema %}
